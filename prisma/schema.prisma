generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  PRODUCTOR
  EMPRESA
  ADMIN
}

enum EntityStatus {
  PENDING
  ACTIVE
  INACTIVE
  DELETED
}

enum TenderStatus {
  DRAFT // Admin editando antes de publicar
  ACCEPTING_REQUESTS // Productores cargan pedidos
  ACCEPTING_PROPOSALS // Empresas cargan ofertas
  CLOSED // Cierre automático por fecha
  AWARDED // Admin eligió ganador, resultado publicado
}

enum TamboSize {
  CHICO // <200
  MEDIANO // 201-600
  GRANDE // 601-1500
  MEGA // >1501
}

enum TamboSystem {
  PASTORIL
  PASTORIL_SUPLEMENTADO
  DRY_LOT
  FREE_STALL
  COMPOST_BARN
}

enum Cuenca {
  CENTRO_CBA_VILLA_MARIA
  SANTA_FE_CENTRO
  SANTA_FE_NORTE
  CBA_SUR
  ENTRE_RIOS_OESTE
  ENTRE_RIOS_ESTE
  CBA_NORTE
  BSAS_OESTE
  BSAS_ABASTO_NORTE
  BSAS_ABASTO_SUR
  BSAS_MAR_Y_SIERRAS
  LA_PAMPA
  NOA
  NEA
  PATAGONICA
}

// ==========================================
// MODELOS PRINCIPALES
// ==========================================

model User {
  id            String       @id @default(uuid())
  firstName     String
  lastName      String
  email         String       @unique
  phone         String? // WhatsApp
  cuit          String?      @unique
  razonSocial   String?
  localidad     String?
  password      String
  imageUrl      String?
  role          Role
  status        EntityStatus @default(ACTIVE)
  termsAccepted Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tambos          Tambo[]
  products        MarketplaceProduct[]
  tenderRequests  TenderRequest[]
  tenderProposals TenderProposal[]
  wonTenders      Tender[]             @relation("TenderWinner")
  forumPosts      ForumPost[]
  forumComments   ForumComment[]
}

model Tambo {
  id       String       @id @default(uuid())
  userId   String
  name     String
  location String // Localidad
  province String // Provincia
  cuenca   Cuenca
  size     TamboSize
  system   TamboSystem
  status   EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user    User               @relation(fields: [userId], references: [id])
  stats   MonthlyStatistic[]
  periods DateStatistic[]

  @@index([userId])
}

// ==========================================
// MÓDULO 1: ESTADÍSTICAS MENSUALES
// ==========================================

model MonthlyStatistic {
  id      String @id @default(uuid())
  tamboId String
  period  String // Formato YYYYMM (ej: "202602"). Primary key lógica para el frontend.
  month   Int // 1-12
  year    Int // Ej: 2026

  // ==========================================
  // VARIABLES INGRESADAS (Ejemplos iniciales)
  // ==========================================
  partosVaquillonas                  Decimal  @db.Decimal(10, 2)
  partosVacas                        Decimal  @db.Decimal(10, 2)
  vacasOrdene                        Decimal  @db.Decimal(10, 2)
  vacasSecas                         Decimal  @db.Decimal(10, 2)
  litrosUsina                        Decimal  @db.Decimal(12, 2)
  litrosDescarte                     Decimal  @db.Decimal(10, 2)
  litrosGuachera                     Decimal  @db.Decimal(10, 2)
  ternerosMuertosPeriparto           Decimal? @db.Decimal(10, 2)
  ternerosMachosNacidosVivos         Decimal? @db.Decimal(10, 2)
  ternerasHembrasNacidasVivas        Decimal? @db.Decimal(10, 2)
  cantNacimientosMellizos            Decimal? @db.Decimal(10, 2)
  ternerosMuertosGuachera            Decimal? @db.Decimal(10, 2)
  ternerosIngresadosGuachera         Decimal? @db.Decimal(10, 2)
  cantTernerasHembrasIngRecria       Decimal? @db.Decimal(10, 2)
  cantHembrasRecriaHastaServMuertas  Decimal? @db.Decimal(10, 2)
  edadVaquillonasPrimerServicioMeses Decimal? @db.Decimal(10, 2)
  cantVacasMuertasMes                Decimal? @db.Decimal(10, 2)
  cantVacasVendidasMes               Decimal? @db.Decimal(10, 2)

  CantVaquillonasPrenadas         Decimal? @db.Decimal(10, 2)
  CantVacasPrenadas               Decimal? @db.Decimal(10, 2)
  CantVacasAbortadas              Decimal? @db.Decimal(10, 2)
  cantVaquillonasAbortadas        Decimal? @db.Decimal(10, 2)
  diasIPPS                        Decimal? @db.Decimal(10, 2)
  porcentajeIPPS                  Decimal? @db.Decimal(5, 2)
  cantVacasMetritis               Decimal? @db.Decimal(10, 2)
  CantVacasRetencionPlacenta      Decimal? @db.Decimal(10, 2)
  cantVacasCaidas                 Decimal? @db.Decimal(10, 2)
  diasDeLeche                     Decimal? @db.Decimal(10, 2)
  conteoCelulasSomaticas          Decimal? @db.Decimal(12, 2)
  conteoBacteriasTotales          Decimal? @db.Decimal(12, 2)
  casosClinicosMastitis           Decimal? @db.Decimal(10, 2)
  conteoCultivoPlacasPositivo     Decimal? @db.Decimal(10, 2)
  conteoCultivoPlacasContaminados Decimal? @db.Decimal(10, 2)

  // ==========================================
  // MÉTRICAS CALCULADAS (Cacheables en la BD)
  // ==========================================
  partosTotales                          Decimal  @db.Decimal(10, 2) // partosVaquillonas + partosVacas
  vacasTotales                           Decimal  @db.Decimal(10, 2) // vacasOrdene + vacasSecas
  promedioLitrosVaca                     Decimal  @db.Decimal(10, 2) // (litrosUsina + litrosDescarte + litrosGuachera) / diasMes / vacasOrdene
  porcentajePartoVaquillonas             Decimal? @db.Decimal(5, 2)
  porcentajeNatimortos                   Decimal? @db.Decimal(5, 2) // (ternerosMuertos * 100) / partosTotales
  totalTernerosNacidosVivos              Decimal? @db.Decimal(10, 2)
  porcentajeTernerosMuertosGuacheraMes   Decimal? @db.Decimal(5, 2)
  porcentajeMortandadRecriaMes           Decimal? @db.Decimal(5, 2)
  proyeccionAnualNatimortos              Decimal? @db.Decimal(5, 2)
  proyeccionAnualTernerosMuertosGuachera Decimal? @db.Decimal(5, 2)
  proyeccionAnualMortandadRecria         Decimal? @db.Decimal(5, 2)

  refugoTotalVacas              Decimal? @db.Decimal(10, 2)
  porcentajeRefugoVacasMes      Decimal? @db.Decimal(5, 2)
  porcentajeRefugoVacasMensual  Decimal? @db.Decimal(5, 2)
  porcentajeVacasMuertasMes     Decimal? @db.Decimal(5, 2)
  porcentajeVacasMuertasMensual Decimal? @db.Decimal(5, 2)
  porcentajeVacasVendidas       Decimal? @db.Decimal(5, 2)

  proyeccionAnualRefugoTotalVacas Decimal? @db.Decimal(5, 2)
  proyeccionAnualVacasMuertas     Decimal? @db.Decimal(5, 2)
  proyeccionAnualVacasVendidas    Decimal? @db.Decimal(5, 2)

  porcentajeVacasPrenadas           Decimal? @db.Decimal(5, 2)
  animalesPrenados                  Decimal? @db.Decimal(10, 2)
  porcentajeAbortoVacasMes          Decimal? @db.Decimal(5, 2)
  acumAnualAbortosVacas             Decimal? @db.Decimal(5, 2)
  porcentajeVaquillonasAbortadasMes Decimal? @db.Decimal(5, 2)
  acumAnualAbortosVaquillonas       Decimal? @db.Decimal(5, 2)
  porcentajeMetritisVacas           Decimal? @db.Decimal(5, 2)
  porcentajeRetencionPlacentaVacas  Decimal? @db.Decimal(5, 2)
  porcentajeVacasCaida              Decimal? @db.Decimal(5, 2)
  crecimientoAnual                  Decimal? @db.Decimal(10, 2)
  acumAnualCrecimientoActual        Decimal? @db.Decimal(5, 2)
  crecimientoFuturo                 Decimal? @db.Decimal(10, 2)
  acumAnualCrecimientoFuturo        Decimal? @db.Decimal(5, 2)
  porcentajeCasosClinicosMastitis   Decimal? @db.Decimal(5, 2)
  conteoCultivoPlacasNegativas      Decimal? @db.Decimal(10, 2)
  porcentajeConteoPlacasPositivo    Decimal? @db.Decimal(5, 2)
  porcentajeConteoPlacasNegativo    Decimal? @db.Decimal(5, 2)
  porcentajeConteoPlacasContaminado Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tambo Tambo @relation(fields: [tamboId], references: [id])

  // Restricción: Un tambo solo puede tener un registro por periodo "YYYYMM"
  @@unique([tamboId, period])
  // Índice para analytics (búsquedas rápidas por fecha)
  @@index([month, year])
}

model DateStatistic {
  id        String   @id @default(uuid())
  tamboId   String
  startDate DateTime
  endDate   DateTime
  year      Int // Año del ciclo para filtrado anual eficiente

  // ==========================================
  // VARIABLES INGRESADAS (Ciclos de 21 días)
  // ==========================================
  vacasElegidas  Decimal @db.Decimal(10, 2) // Vacas elegidas para el análisis reproductivo
  vacasEnCelo    Decimal @db.Decimal(10, 2) // Vacas vistas en celo
  vacasPreniadas Decimal @db.Decimal(10, 2) // Vacas preñadas

  // ==========================================
  // MÉTRICAS CALCULADAS (Ciclos de 21 días)
  // ==========================================
  porcentajeCelo    Decimal @db.Decimal(10, 4) // % de celo de vacas
  porcentajePreniez Decimal @db.Decimal(10, 4) // % de preñez de vacas
  tasaPreniez       Decimal @db.Decimal(10, 4) // Tasa de preñez de vacas

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tambo Tambo @relation(fields: [tamboId], references: [id])

  // Restricción: Un tambo no puede tener 2 ciclos que inicien el mismo día (evita duplicados)
  @@unique([tamboId, startDate, endDate])
  @@index([startDate])
  @@index([tamboId, year])
}

// ==========================================
// MÓDULO 2: MARKETPLACE
// ==========================================

model MarketplaceProduct {
  id          String       @id @default(uuid())
  producerId  String
  name        String
  description String       @db.Text
  category    String
  price       Decimal      @db.Decimal(10, 2)
  priceCurrency String     @default("ARS")
  unit        String
  images      Json // Array de URLs
  location    String
  isAvailable Boolean      @default(true)
  status      EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  producer User @relation(fields: [producerId], references: [id])

  @@index([producerId])
  @@index([category])
}

// ==========================================
// MÓDULO 3: LICITACIONES
// ==========================================

model Tender {
  id                 String       @id @default(uuid())
  title              String // Nombre descriptivo
  product            String // Ej: "Núcleo Mineral"
  volumeUnit         String       @default("unidades") // Unidad para pedidos y cotizaciones
  priceCurrency      String       @default("ARS") // ARS ($) o USD_BN (USD Banco Nación)
  specifications     String       @db.Text // Especificaciones técnicas
  deliveryConditions String       @db.Text
  paymentOptions     Json // Array de strings: ["contado","30 días"]
  status             TenderStatus @default(DRAFT)
  totalPedidoTender  Decimal      @default(0) @db.Decimal(12, 2)

  requestStartDate  DateTime // Inicio: productores cargan pedidos
  requestDeadline   DateTime // Corte: fin de carga de pedidos
  proposalStartDate DateTime // Inicio: empresas cargan ofertas
  proposalDeadline  DateTime // Cierre exacto de recepción de ofertas

  winnerId  String? // Empresa adjudicada por el Admin
  awardedAt DateTime? // Cuando el Admin publicó el resultado
  closedAt  DateTime? // Timestamp automático del cierre

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests  TenderRequest[]
  proposals TenderProposal[]
  winner    User?            @relation("TenderWinner", fields: [winnerId], references: [id])

  @@index([status])
}

model TenderRequest {
  id         String  @id @default(uuid())
  tenderId   String
  producerId String
  quantity   Decimal @db.Decimal(12, 2) // En la unidad del tender
  notes      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tender   Tender @relation(fields: [tenderId], references: [id])
  producer User   @relation(fields: [producerId], references: [id])

  @@unique([tenderId, producerId]) // Un productor, un pedido por licitación
  @@index([tenderId])
}

model TenderProposal {
  id           String @id @default(uuid())
  proposalCode String @unique // Ej: "PROP-2026-A3F2"
  tenderId     String
  companyId    String

  pricePerUnit        Decimal @db.Decimal(12, 2)
  paymentMethod       String // Según opciones del tender
  logisticsConditions String  @db.Text
  offerValidity       String // Ej: "30 días desde envío"

  isSubmitted Boolean   @default(false) // Bloqueada al enviar
  submittedAt DateTime? // Fecha/hora exacta de envío

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tender  Tender @relation(fields: [tenderId], references: [id])
  company User   @relation(fields: [companyId], references: [id])

  @@unique([tenderId, companyId]) // Una empresa, una oferta por licitación
  @@index([tenderId])
}

// ==========================================
// MÓDULO 4: FOROS
// ==========================================

model ForumPost {
  id       String       @id @default(uuid())
  authorId String
  title    String
  content  String       @db.Text
  category String
  status   EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  author   User           @relation(fields: [authorId], references: [id])
  comments ForumComment[]

  @@index([authorId])
  @@index([category])
}

model ForumComment {
  id       String       @id @default(uuid())
  postId   String
  authorId String
  parentId String? // Para sub-comentarios (hilos)
  content  String       @db.Text
  status   EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  post    ForumPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id])
  parent  ForumComment?  @relation("CommentToComment", fields: [parentId], references: [id])
  replies ForumComment[] @relation("CommentToComment")

  @@index([postId])
  @@index([parentId])
}

// ==========================================
// MÓDULO 5: SPONSORS (Isla)
// ==========================================

model Sponsor {
  id          String       @id @default(uuid())
  name        String
  description String?      @db.Text
  imageUrl    String
  youtubeUrl  String?
  status      EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
