{
    "version": 2,
    "builds": [
        {
            "src": "dist/app.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "dist/app.js"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/billing-promotions",
            "schedule": "0 12 * * *"
        }
    ]
}