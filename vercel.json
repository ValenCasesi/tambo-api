{
    "version": 2,
    "builds": [
        {
            "src": "dist/app.js",
            "use": "@vercel/node",
            "config": {
                "maxDuration": 60
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "dist/app.js"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/billing-promotions",
            "schedule": "0 12 * * *"
        },
        {
            "path": "/api/cron/billing-installments",
            "schedule": "0 6 * * *"
        }
    ]
}